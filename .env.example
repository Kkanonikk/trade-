# Скопируй этот файл в .env и вставь свой refresh-токен БКС (только чтение).
# Файл .env в git не попадает.
BCS_REFRESH_TOKEN=
BCS_CLIENT_ID=trade-api-read
# Адреса API БКС. Менять нужно, только если БКС изменит их.
BCS_AUTH_URL=https://be.broker.ru/trade-api-keycloak/realms/tradeapi/protocol/openid-connect/token
BCS_API_URL=https://be.broker.ru/trade-api-market-data-connector/api/v1
